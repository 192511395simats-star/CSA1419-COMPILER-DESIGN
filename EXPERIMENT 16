#include <stdio.h>
#include <string.h>

struct TAC
{
    char result[10];
    char arg1[10];
    char op;
    char arg2[10];
};

int main()
{
    struct TAC code[20];
    int n, i;

    printf("Enter number of Three Address Code statements: ");
    scanf("%d", &n);

    printf("\nEnter TAC statements in the form:\n");
    printf("result arg1 operator arg2\n\n");

    for (i = 0; i < n; i++)
    {
        printf("Statement %d: ", i + 1);

        scanf("%s %s %c %s",
              code[i].result,
              code[i].arg1,
              &code[i].op,
              code[i].arg2);
    }

    printf("\n----- TARGET CODE -----\n");

    for (i = 0; i < n; i++)
    {
        printf("MOV R0, %s\n", code[i].arg1);

        switch (code[i].op)
        {
            case '+':
                printf("ADD R0, %s\n", code[i].arg2);
                break;

            case '-':
                printf("SUB R0, %s\n", code[i].arg2);
                break;

            case '*':
                printf("MUL R0, %s\n", code[i].arg2);
                break;

            case '/':
                printf("DIV R0, %s\n", code[i].arg2);
                break;

            default:
                printf("Invalid operator\n");
        }

        printf("MOV %s, R0\n", code[i].result);
    }

    return 0;
}
