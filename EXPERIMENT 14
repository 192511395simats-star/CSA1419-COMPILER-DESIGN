#include <stdio.h>
#include <string.h>
#include <ctype.h>

char expr[100];
int tempCount = 1;

/* Generate a new temporary variable */
void newTemp(char *temp)
{
    sprintf(temp, "t%d", tempCount++);
}

/* Get operator precedence */
int precedence(char op)
{
    if (op == '*' || op == '/')
        return 2;

    if (op == '+' || op == '-')
        return 1;

    return 0;
}

/* Generate Three Address Code */
void generateTAC()
{
    char operandStack[100][20];
    char operatorStack[100];
    int operandTop = -1;
    int operatorTop = -1;

    int i = 0;

    while (expr[i] != '\0')
    {
        /* Ignore spaces */
        if (expr[i] == ' ')
        {
            i++;
            continue;
        }

        /* Operand */
        if (isalnum(expr[i]))
        {
            char operand[20];
            int j = 0;

            while (isalnum(expr[i]))
            {
                operand[j++] = expr[i++];
            }

            operand[j] = '\0';

            strcpy(operandStack[++operandTop], operand);
        }

        /* Left parenthesis */
        else if (expr[i] == '(')
        {
            operatorStack[++operatorTop] = expr[i];
            i++;
        }

        /* Right parenthesis */
        else if (expr[i] == ')')
        {
            while (operatorTop >= 0 &&
                   operatorStack[operatorTop] != '(')
            {
                char op = operatorStack[operatorTop--];

                char op2[20], op1[20], temp[20];

                strcpy(op2, operandStack[operandTop--]);
                strcpy(op1, operandStack[operandTop--]);

                newTemp(temp);

                printf("%s = %s %c %s\n",
                       temp, op1, op, op2);

                strcpy(operandStack[++operandTop], temp);
            }

            if (operatorTop >= 0 &&
                operatorStack[operatorTop] == '(')
            {
                operatorTop--;
            }

            i++;
        }

        /* Operator */
        else
        {
            while (operatorTop >= 0 &&
                   precedence(operatorStack[operatorTop])
                   >= precedence(expr[i]) &&
                   operatorStack[operatorTop] != '(')
            {
                char op = operatorStack[operatorTop--];

                char op2[20], op1[20], temp[20];

                strcpy(op2, operandStack[operandTop--]);
                strcpy(op1, operandStack[operandTop--]);

                newTemp(temp);

                printf("%s = %s %c %s\n",
                       temp, op1, op, op2);

                strcpy(operandStack[++operandTop], temp);
            }

            operatorStack[++operatorTop] = expr[i];
            i++;
        }
    }

    /* Process remaining operators */
    while (operatorTop >= 0)
    {
        char op = operatorStack[operatorTop--];

        char op2[20], op1[20], temp[20];

        strcpy(op2, operandStack[operandTop--]);
        strcpy(op1, operandStack[operandTop--]);

        newTemp(temp);

        printf("%s = %s %c %s\n",
               temp, op1, op, op2);

        strcpy(operandStack[++operandTop], temp);
    }
}

int main()
{
    printf("Enter an arithmetic expression: ");
    scanf("%s", expr);

    printf("\nThree Address Code:\n");
    printf("-------------------------\n");

    generateTAC();

    return 0;
}
